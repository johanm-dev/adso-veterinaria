        <mxCell id="ley_col1" value="&lt;b&gt;Notación de Claves:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;PK&lt;/b&gt;: Llave primaria (GENERATED ALWAYS AS IDENTITY)&lt;br&gt;• &lt;b&gt;FK&lt;/b&gt;: Llave foránea (Integridad Referencial)&lt;br&gt;• &lt;b&gt;UQ / CK&lt;/b&gt;: Restricción UNIQUE / CHECK" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#334155;" vertex="1" parent="leyenda">
          <mxGeometry x="20" y="34" width="440" height="80" as="geometry" />
