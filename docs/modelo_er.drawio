        <mxCell id="ley_col2" value="&lt;b&gt;Tipos de Entidad y Cardinalidad:&lt;/b&gt;&lt;br&gt;• Verde (#0F766E): Tablas Maestras y Transaccionales&lt;br&gt;• Ámbar (#B45309): Tabla asociativa N:M (aplicacion_vacuna)&lt;br&gt;• Azul (#1E3A8A): Seguridad y Control de Acceso RBAC (usuario)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#334155;" vertex="1" parent="leyenda">
          <mxGeometry x="490" y="34" width="450" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ley_col3" value="&lt;b&gt;Reglas Implementadas en DDL:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;RN-01&lt;/b&gt;: CHECK (proxima_dosis &gt; fecha_aplicacion)&lt;br&gt;• &lt;b&gt;RN-02&lt;/b&gt;: propietario → mascota ON DELETE RESTRICT&lt;br&gt;• &lt;b&gt;RN-03&lt;/b&gt;: UNIQUE (veterinario_id, fecha) en consulta" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#334155;" vertex="1" parent="leyenda">
